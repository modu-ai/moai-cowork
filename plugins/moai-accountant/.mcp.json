{
  "mcpServers": {
    "dart": {
      "$comment": "OpenDART 전자공시용 제3자 MCP. 도구 목록과 호출 한도는 설치된 서버 및 OpenDART의 현재 안내를 확인한다. 인증키는 앱 입력란 또는 개인 자격증명 파일에서 런처가 읽는다.",
      "command": "uv",
      "args": [
        "run",
        "--script",
        "${CLAUDE_PLUGIN_ROOT}/mcp-launch/mcp_launch.py",
        "--service",
        "dart",
        "--keys",
        "DART_API_KEY",
        "--",
        "npx",
        "-y",
        "korean-dart-mcp"
      ],
      "env": {
        "DART_API_KEY": "${user_config.DART_API_KEY}"
      }
    }
  }
}
