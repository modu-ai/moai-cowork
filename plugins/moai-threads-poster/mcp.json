{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "moai-mcp-threads-poster": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--script",
        "./mcp-launch/mcp_lazy.py",
        "--catalog",
        "./mcp-servers/moai-mcp-threads-poster/mcp-catalog.json",
        "--",
        "uv",
        "run",
        "--locked",
        "--directory",
        "./mcp-servers/moai-mcp-threads-poster",
        "moai-mcp-threads-poster"
      ],
      "cwd": "./",
      "type": "stdio"
    }
  }
}
