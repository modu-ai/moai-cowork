{
  "name": "moai-lawyer",
  "version": "1.4.13",
  "description": "법무 전담 AI 코워커 — 계약 검토·NDA 트리아지·컴플라이언스 점검·법령/판례 리서치·국내외 특허/상표 선행조사·식약처 안전 기준 스킬. 국가법령정보 MCP(korean-law)로 인용을 검증하고, 특허/상표 공식 데이터 MCP(moai-mcp-ip)로 한국·미국·일본·유럽 DB를 조회합니다. 이런 분께 추천: 1인 사업자·스타트업 운영자. ※ 법률 자문 대체가 아닌 참고 자료입니다.",
  "author": {
    "name": "모두의 AI",
    "email": "email@mo.ai.kr",
    "url": "https://cowork.mo.ai.kr"
  },
  "homepage": "https://cowork.mo.ai.kr/plugins/",
  "repository": "https://github.com/modu-ai/moai-cowork",
  "license": "Apache-2.0",
  "keywords": [
    "moai",
    "lawyer",
    "legal",
    "contract",
    "compliance",
    "법무",
    "계약"
  ],
  "skills": "./skills/",
  "mcpServers": {
    "korean-law": {
      "command": "uv",
      "args": [
        "run",
        "--script",
        "./mcp-launch/mcp_launch.py",
        "--service",
        "korean-law",
        "--keys",
        "LAW_OC",
        "--",
        "npx",
        "--yes",
        "--ignore-scripts",
        "--omit=optional",
        "korean-law-mcp"
      ],
      "cwd": "."
    },
    "moai-mcp-ip": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "./mcp-servers/moai-mcp-ip",
        "moai-mcp-ip"
      ],
      "cwd": "."
    }
  },
  "interface": {
    "displayName": "⚖️ 법무 담당",
    "shortDescription": "⚖️ 법무 담당 — 계약 검토·컴플라이언스·법령 리서치",
    "longDescription": "법무 전담 AI 코워커 — 계약 검토·NDA 트리아지·컴플라이언스 점검·법령/판례 리서치·국내외 특허/상표 선행조사·식약처 안전 기준 스킬. 국가법령정보 MCP(korean-law)로 인용을 검증하고, 특허/상표 공식 데이터 MCP(moai-mcp-ip)로 한국·미국·일본·유럽 DB를 조회합니다. 이런 분께 추천: 1인 사업자·스타트업 운영자. ※ 법률 자문 대체가 아닌 참고 자료입니다.",
    "developerName": "모두의 AI",
    "category": "Legal",
    "capabilities": [
      "Read",
      "Write"
    ],
    "websiteURL": "https://cowork.mo.ai.kr",
    "defaultPrompt": [
      "표준 NDA 초안 검토해줘",
      "특허 선행기술 검색해줘"
    ],
    "brandColor": "#3d7d5f"
  }
