{
  "name": "moai-media",
  "version": "3.3.13",
  "description": "미디어 생성 전담 AI 코워커 — ChatGPT Work 기본 이미지 생성, Higgsfield 이미지·영상·제품 촬영·캐릭터 일관성(Soul/Element), ElevenLabs TTS/보이스클로닝, GPT Image 2.5·Gemini 3·Midjourney v8 프롬프트 빌더와 NotebookLM 연동. Higgsfield 3D·설명 영상 완성은 현재 연결에 제출·조립 도구가 있을 때만 진행합니다. 정확한 GPT Image 2.5 지정에는 별도 모델 선택 경로를 확인합니다.",
  "author": {
    "name": "모두의 AI",
    "email": "email@mo.ai.kr",
    "url": "https://cowork.mo.ai.kr"
  },
  "homepage": "https://cowork.mo.ai.kr/plugins/",
  "repository": "https://github.com/modu-ai/moai-cowork",
  "license": "Apache-2.0",
  "keywords": [
    "moai",
    "media",
    "image",
    "video",
    "audio",
    "generation",
    "미디어",
    "생성"
  ],
  "skills": "./skills/",
  "mcpServers": {
    "ElevenLabs": {
      "command": "uv",
      "args": [
        "run",
        "--script",
        "./mcp-launch/mcp_launch.py",
        "--service",
        "elevenlabs",
        "--keys",
        "ELEVENLABS_API_KEY",
        "--",
        "uvx",
        "elevenlabs-mcp"
      ],
      "cwd": "."
    },
    "higgsfield": {
      "type": "http",
      "url": "https://mcp.higgsfield.ai/mcp",
      "timeout": 120000,
      "headers": {
        "User-Agent": "MoAI-Media/3.3.9"
      }
    },
    "moai-mcp-openai": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "./mcp-servers/moai-mcp-openai",
        "moai-mcp-openai"
      ],
      "cwd": "."
    }
  },
  "interface": {
    "displayName": "🎬 미디어 크리에이터",
    "shortDescription": "🎬 미디어 크리에이터 — 이미지·영상·오디오 멀티모달 생성",
    "longDescription": "미디어 생성 전담 AI 코워커 — ChatGPT Work 기본 이미지 생성, Higgsfield 이미지·영상·3D·설명영상·제품촬영·캐릭터 일관성(Soul/Element), ElevenLabs TTS/보이스클로닝, GPT Image 2.5·Gemini 3·Midjourney v8 프롬프트 빌더와 NotebookLM 연동. 정확한 GPT Image 2.5 지정에는 별도 모델 선택 경로를 확인합니다.",
    "developerName": "모두의 AI",
    "category": "Media",
    "capabilities": [
      "Read",
      "Write"
    ],
    "websiteURL": "https://cowork.mo.ai.kr",
    "defaultPrompt": [
      "제품 이미지 생성해줘",
      "설명영상 시나리오 만들어줘"
    ],
    "brandColor": "#3d7d5f"
  }
}
