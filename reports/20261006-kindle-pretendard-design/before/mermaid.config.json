{
  "theme": "base",
  "securityLevel": "strict",
  "flowchart": {
    "htmlLabels": false,
    "curve": "step",
    "nodeSpacing": 34,
    "rankSpacing": 24,
    "padding": 20
  },
  "themeVariables": {
    "fontFamily": "NeoDunggeunmo, monospace",
    "fontSize": "16px",
    "primaryColor": "#f4f4ef",
    "primaryTextColor": "#202020",
    "primaryBorderColor": "#707070",
    "secondaryColor": "#ddddd6",
    "secondaryTextColor": "#202020",
    "secondaryBorderColor": "#707070",
    "tertiaryColor": "#e9e9e5",
    "tertiaryTextColor": "#202020",
    "tertiaryBorderColor": "#707070",
    "lineColor": "#707070",
    "textColor": "#202020",
    "mainBkg": "#f4f4ef",
    "nodeBorder": "#707070",
    "nodeTextColor": "#202020",
    "edgeLabelBackground": "#e9e9e5",
    "clusterBkg": "#e9e9e5",
    "clusterBorder": "#707070",
    "actorBkg": "#f4f4ef",
    "actorBorder": "#707070",
    "actorTextColor": "#202020",
    "actorLineColor": "#707070",
    "signalColor": "#707070",
    "signalTextColor": "#202020",
    "labelBoxBkgColor": "#eeeeee",
    "labelBoxBorderColor": "#707070",
    "labelTextColor": "#202020",
    "loopTextColor": "#202020",
    "noteBkgColor": "#ddddd6",
    "noteBorderColor": "#707070",
    "noteTextColor": "#202020",
    "activationBkgColor": "#eeeeee",
    "activationBorderColor": "#707070"
  },
  "fontFamily": "NeoDunggeunmo, monospace",
  "htmlLabels": false,
  "sequence": {
    "actorMargin": 32,
    "width": 120,
    "height": 44,
    "diagramMarginX": 20,
    "messageMargin": 32,
    "actorFontSize": 16,
    "messageFontSize": 16,
    "noteFontSize": 16,
    "useMaxWidth": false
  },
  "themeCSS": ".node rect,.actor{rx:0;ry:0;} text{font-weight:400;font-style:normal;}"
}
